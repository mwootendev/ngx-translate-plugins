{
  "name": "ngx-translate-testing",
  "description": "A library of utilities for testing with the ngx-translate i18n Angular library",
  "version": "0.0.0-development",
  "homepage": "https://github.com/safe-fleet/ngx-translate-plugins#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "yarn run build:lib && yarn run build:app",
    "build:app": "ng build",
    "build:lib": "ng build testing",
    "build:lib:prod": "yarn run build:lib --configuration production",
    "clean": "rimraf dist coverage",
    "coverage:app": "yarn run test:app --code-coverage true",
    "coverage:lib": "yarn run test:lib --code-coverage true",
    "pretest": "yarn run build:lib",
    "test": "jest --c=jest.config.js",
    "lint": "yarn run lint:lib && yarn run lint:app",
    "lint:app": "ng lint --project=ngx-translate-plugins",
    "lint:lib": "ng lint --project=testing",
    "lint:fix": "yarn run prettier && ng lint --fix",
    "prettier": "prettier --config ./.prettierrc --write \"projects/**/*{.ts,.js,.json,.css,.scss}\"",
    "prettier-check": "prettier --config ./.prettierrc --check \"projects/**/*{.ts,.js,.json,.css,.scss}\"",
    "e2e": "ng e2e",
    "precommit": "yarn run lint",
    "pack:lib": "cd dist/testing && yarn pack",
    "package:lib": "yarn run build:lib:prod && yarn run pack:lib"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safe-fleet/ngx-translate-plugins.git"
  },
  "bugs": {
    "url": "https://safefleet.atlassian.net/browse"
  },
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/forms": "^20.3.30",
    "@angular/platform-browser": "^20.3.30",
    "@angular/platform-browser-dynamic": "^20.3.30",
    "@angular/router": "^20.3.30",
    "@messageformat/core": "^3.4.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "core-js": "^3.43.0",
    "messageformat": "^4.0.0",
    "ngx-translate-messageformat-compiler": "^7.1.0",
    "rxjs": "^7.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "20.3.36",
    "@angular/cli": "^20.3.36",
    "@angular/compiler-cli": "^20.3.30",
    "@angular/language-service": "^20.3.30",
    "@angular/localize": "^20.3.30",
    "@types/jasmine": "^3.10.2",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^7.0.4",
    "jasmine-core": "^3.10.1",
    "jasmine-spec-reporter": "^7.0.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "lint-staged": "^16.1.2",
    "ng-packagr": "^20.3.2",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.4.5"
  }
}
